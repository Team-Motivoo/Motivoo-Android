<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_main"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="sopt.teammotivoo.presentation.intro.SplashFragment"
        android:label="SplashFragment">
        <action
            android:id="@+id/action_splashFragment_to_permissionFragment"
            app:destination="@id/permissionFragment" />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_splashFragment_to_startMotivooFragment"
            app:destination="@id/startMotivooFragment" />
        <action
            android:id="@+id/action_splashFragment_to_termsOfUseFragment"
            app:destination="@id/termsOfUseFragment" />
        <action
            android:id="@+id/action_splashFragment_to_descriptionFragment"
            app:destination="@id/descriptionFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"/>
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="sopt.teammotivoo.presentation.auth.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_loginFragment_to_startMotivooFragment"
            app:destination="@id/startMotivooFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_loginFragment_to_termsOfUseFragment"
            app:destination="@id/termsOfUseFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_loginFragment_to_permissionFragment"
            app:destination="@id/permissionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_loginFragment_to_descriptionFragment"
            app:destination="@id/descriptionFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="sopt.teammotivoo.presentation.home.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_homeBottomSheetFragment"
            app:destination="@id/homeBottomSheetFragment" />
        <action
            android:id="@+id/action_homeFragment_to_webViewFragment"
            app:destination="@+id/webViewFragment" />
        <action
            android:id="@+id/action_homeFragment_to_withdrawalFragment"
            app:destination="@id/withdrawalFragment" />
    </fragment>
    <fragment
        android:id="@+id/myPageFragment"
        android:name="sopt.teammotivoo.presentation.mypage.MyPageFragment"
        android:label="MyPageFragment">
        <action
            android:id="@+id/action_myPageFragment_to_myInfoFragment"
            app:destination="@id/myInfoFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_myExerciseInfoFragment"
            app:destination="@id/myExerciseInfoFragment" />
        <action
            android:id="@+id/action_myPageFragment_to_webViewFragment"
            app:destination="@id/webViewFragment" />
    </fragment>
    <fragment
        android:id="@+id/exerciseFragment"
        android:name="sopt.teammotivoo.presentation.exercise.ExerciseFragment"
        android:label="ExerciseFragment">
        <action
            android:id="@+id/action_exerciseFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/webViewFragment"
        android:name="sopt.teammotivoo.presentation.WebViewFragment"
        android:label="WebViewFragment">
        <argument
            android:name="url"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/ageQuestionFragment"
        android:name="sopt.teammotivoo.presentation.onboarding.AgeQuestionFragment"
        android:label="AgeQuestionFragment">
        <action
            android:id="@+id/action_ageQuestionFragment_to_doExerciseQuestionFragment"
            app:destination="@id/doExerciseQuestionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/doExerciseQuestionFragment"
        android:name="sopt.teammotivoo.presentation.onboarding.DoExerciseQuestionFragment"
        android:label="DoExerciseQuestionFragment">
        <action
            android:id="@+id/action_doExerciseQuestionFragment_to_whatExerciseQuestionFragment"
            app:destination="@id/whatExerciseQuestionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_doExerciseQuestionFragment_to_whatActivityQuestionFragment"
            app:destination="@id/whatActivityQuestionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/soreSpotQuestionFragment"
        android:name="sopt.teammotivoo.presentation.onboarding.SoreSpotQuestionFragment"
        android:label="soreSpotQuestionFragment">
        <action
            android:id="@+id/action_soreSpotQuestionFragment_to_startMotivooFragment"
            app:destination="@id/startMotivooFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/whatExerciseQuestionFragment"
        android:name="sopt.teammotivoo.presentation.onboarding.WhatExerciseQuestionFragment"
        android:label="WhatExerciseQuestionFragment">
        <action
            android:id="@+id/action_whatExerciseQuestionFragment_to_frequencyQuestionFragment"
            app:destination="@id/frequencyQuestionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/whatActivityQuestionFragment"
        android:name="sopt.teammotivoo.presentation.onboarding.WhatActivityQuestionFragment"
        android:label="WhatActivityQuestionFragment">
        <action
            android:id="@+id/action_whatActivityQuestionFragment_to_frequencyQuestionFragment"
            app:destination="@id/frequencyQuestionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/frequencyQuestionFragment"
        android:name="sopt.teammotivoo.presentation.onboarding.FrequencyQuestionFragment"
        android:label="FrequencyQuestionFragment">
        <action
            android:id="@+id/action_frequencyQuestionFragment_to_timeQuestionFragment"
            app:destination="@id/timeQuestionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <argument
            android:name="doExerciseType"
            app:argType="sopt.teammotivoo.presentation.type.DoExerciseType" />
    </fragment>
    <fragment
        android:id="@+id/timeQuestionFragment"
        android:name="sopt.teammotivoo.presentation.onboarding.TimeQuestionFragment"
        android:label="TimeQuestionFragment">
        <action
            android:id="@+id/action_timeQuestionFragment_to_soreSpotQuestionFragment"
            app:destination="@id/soreSpotQuestionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <argument
            android:name="doExerciseType"
            app:argType="sopt.teammotivoo.presentation.type.DoExerciseType" />
    </fragment>
    <fragment
        android:id="@+id/getInviteCodeFragment"
        android:name="sopt.teammotivoo.presentation.invitecode.GetInviteCodeFragment"
        android:label="GetInviteCodeFragment">
        <action
            android:id="@+id/action_getInviteCodeFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/postInviteCodeFragment"
        android:name="sopt.teammotivoo.presentation.invitecode.PostInviteCodeFragment"
        android:label="PostInviteCodeFragment">
        <action
            android:id="@+id/action_postInviteCodeFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/myInfoFragment"
        android:name="sopt.teammotivoo.presentation.mypage.MyInfoFragment"
        android:label="MyInfoFragment">
        <action
            android:id="@+id/action_myInfoFragment_to_myServiceOut"
            app:destination="@id/myServiceOutFragment" />
        <action
            android:id="@+id/action_myInfoFragment_to_myLogout"
            app:destination="@id/myLogoutFragment" />
        <argument
            android:name="userNickname"
            app:argType="string" />
        <argument
            android:name="userAge"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/myExerciseInfoFragment"
        android:name="sopt.teammotivoo.presentation.my_exercise_info.MyExerciseInfoFragment"
        android:label="MyExerciseInfoFragment">
        <action
            android:id="@+id/action_myExerciseInfoFragment_to_myPageFragment"
            app:destination="@id/myPageFragment" />
    </fragment>
    <dialog
        android:id="@+id/myServiceOutFragment"
        android:name="sopt.teammotivoo.presentation.mypage.MyServiceOutFragment"
        android:label="MyServiceOutFragment">

    </dialog>
    <dialog
        android:id="@+id/myLogoutFragment"
        android:name="sopt.teammotivoo.presentation.mypage.MyLogoutFragment"
        android:label="MyLogoutFragment">

    </dialog>
    <fragment
        android:id="@+id/permissionFragment"
        android:name="sopt.teammotivoo.presentation.intro.PermissionFragment"
        android:label="PermissionFragment">
        <action
            android:id="@+id/action_permissionFragment_to_termsOfUseFragment"
            app:destination="@id/termsOfUseFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/termsOfUseFragment"
        android:name="sopt.teammotivoo.presentation.intro.TermsOfUseFragment"
        android:label="TermsOfUseFragment">
        <action
            android:id="@+id/action_termsOfUseFragment_to_webViewFragment"
            app:destination="@id/webViewFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_termsOfUseFragment_to_descriptionFragment"
            app:destination="@id/descriptionFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/startMotivooFragment"
        android:name="sopt.teammotivoo.presentation.intro.StartMotivooFragment"
        android:label="StartMotivooFragment">
        <action
            android:id="@+id/action_startMotivooFragment_to_postInviteCodeFragment"
            app:destination="@id/postInviteCodeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_startMotivooFragment_to_getInviteCodeFragment"
            app:destination="@id/getInviteCodeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <dialog
        android:id="@+id/homeBottomSheetFragment"
        android:name="sopt.teammotivoo.presentation.home.bottomsheet.HomeBottomSheetFragment"
        android:label="HomeBottomSheetFragment">
        <action
            android:id="@+id/action_homeBottomSheetFragment_to_homePhotoDialogFragment"
            app:destination="@id/homePhotoDialogFragment"
            app:popUpTo="@id/homeBottomSheetFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeBottomSheetFragment_to_homeConfirmDialogFragment"
            app:destination="@id/homeConfirmDialogFragment"
            app:popUpTo="@id/homeBottomSheetFragment"
            app:popUpToInclusive="true" />
    </dialog>
    <dialog
        android:id="@+id/homePhotoDialogFragment"
        android:name="sopt.teammotivoo.presentation.home.dialog.HomePhotoDialogFragment"
        android:label="HomePhotoDialogFragment">
        <action
            android:id="@+id/action_homePhotoDialogFragment_to_homeConfirmDialogFragment"
            app:destination="@id/homeConfirmDialogFragment"
            app:popUpTo="@id/homePhotoDialogFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="photoUri"
            app:argType="android.net.Uri" />
    </dialog>
    <dialog
        android:id="@+id/homeConfirmDialogFragment"
        android:name="sopt.teammotivoo.presentation.home.dialog.HomeConfirmDialogFragment"
        android:label="HomeConfirmDialogFragment">
        <argument
            android:name="photoUri"
            app:argType="android.net.Uri"
            app:nullable="true" />
    </dialog>
    <fragment
        android:id="@+id/loadingFragment"
        android:name="sopt.teammotivoo.presentation.loading.LoadingFragment"
        android:label="LoadingFragment" />
    <fragment
        android:id="@+id/withdrawalFragment"
        android:name="sopt.teammotivoo.presentation.withdrawal.WithdrawalFragment"
        android:label="WithdrawalFragment">
        <action
            android:id="@+id/action_withdrawalFragment_to_myServiceOutFragment"
            app:destination="@id/myServiceOutFragment" />
    </fragment>
    <fragment
        android:id="@+id/networkErrorFragment"
        android:name="sopt.teammotivoo.presentation.NetworkErrorFragment"
        android:label="NetworkErrorFragment" />
    <fragment
        android:id="@+id/nickNameFragment"
        android:name="sopt.teammotivoo.presentation.onboarding.NickNameFragment"
        android:label="NickNameFragment">
        <action
            android:id="@+id/action_nickNameFragment_to_ageQuestionFragment"
            app:destination="@id/ageQuestionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/descriptionFragment"
        android:name="sopt.teammotivoo.presentation.onboarding.DescriptionFragment"
        android:label="DescriptionFragment">
        <action
            android:id="@+id/action_descriptionFragment_to_nickNameFragment"
            app:destination="@id/nickNameFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out" />
    </fragment>
</navigation>